    "test:11": "forge test --match-path \"test/{staking/*.t.sol,ExecuteStake50Flow.t.sol}\"",
    "test:all": "pnpm test:1 && pnpm test:2 && pnpm test:3 && pnpm test:4 && pnpm test:5 && pnpm test:6 && pnpm test:7 && pnpm test:8 && pnpm test:9 && pnpm test:10 && pnpm test:11",
    "clean": "forge clean",
    "lint": "solhint 'src/**/*.sol'"
