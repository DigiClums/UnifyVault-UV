{
  "name": "@unifyvault/protocol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "./scripts/safe-forge-build.sh",
    "test": "./scripts/safe-forge-test.sh",
    "test:1": "./scripts/safe-forge-test.sh --match-path \"test/unit/*\"",
    "test:2": "./scripts/safe-forge-test.sh --match-path \"test/{AddressValidationLib,MathValidationLib,OracleValidationLib,ShareLibPrecision,GovernanceMigration,GenesisNAVAndMigration,ProtocolDirectory,TimelockHardening,SecurityMonitoringEvents}.t.sol\"",
    "test:3": "./scripts/safe-forge-test.sh --match-path \"test/{Treasury,TreasuryUVBEIntegration,CustodyVault,AccountingModel,RateLimits}.t.sol\"",
    "test:4": "./scripts/safe-forge-test.sh --match-path \"test/{ChainlinkOracleProvider,OracleAdapter,OracleCircuitBreaker,OracleManager,OracleProvider}.t.sol\"",
    "test:5": "./scripts/safe-forge-test.sh --match-path \"test/{PortfolioManager,StrategyManager,LiquidityManager}.t.sol\"",
    "test:6": "./scripts/safe-forge-test.sh --match-path \"test/{UnifyVaultController,UnifyVaultControllerUpgradeable,DeployUnifyVaultControllerUUPS,DepositCollateral,DepositMinting,DepositValidation,DebugDepositQuote,Redemption,RedemptionDecimalScaling,UVBTCETHToken}.t.sol\"",
    "test:7": "./scripts/safe-forge-test.sh --match-path \"test/{DepositFeeRouting,FeeManager,SwapAdapter,SwapProtection}.t.sol\"",
    "test:8": "./scripts/safe-forge-test.sh --match-path \"test/{integration/*.t.sol,ControllerIntegration.t.sol,FeeManagerIntegration.t.sol,LiveSim.t.sol,EconomicAdversarial.t.sol}\"",
    "test:9": "./scripts/safe-forge-test.sh --match-path \"test/{BaseMainnetFork,fork/Batch1MainnetSimulationTest,fork/PhaseENavV4StabilizerForkSimulationTest}.t.sol\"",
    "test:10": "./scripts/safe-forge-test.sh --match-path \"test/{invariant/*.t.sol,ChainlinkOracleProviderInvariant.t.sol,CustodyVaultInvariant.t.sol,DepositCollateralInvariant.t.sol,DepositFeeRoutingInvariant.t.sol,DepositMintingInvariant.t.sol,DepositValidationInvariant.t.sol,OracleManagerInvariant.t.sol,OracleProviderInvariant.t.sol,RedemptionInvariant.t.sol,TreasuryInvariant.t.sol,UnifyVaultControllerInvariant.t.sol,UVBTCETHTokenInvariant.t.sol,RedemptionFuzz.t.sol,V2ProtocolInvariants.t.sol}\"",
    "test:11": "./scripts/safe-forge-test.sh --match-path \"test/staking/*.t.sol\"",
    "test:fork:live": "test -n \"$BASE_SEPOLIA_RPC_URL\" && forge test --match-path \"test/{fork/*.t.sol,ExecuteStake50Flow.t.sol}\" || echo \"Skipping live Base Sepolia RPC tests (BASE_SEPOLIA_RPC_URL not set)\"",
    "test:all": "pnpm test:1 && pnpm test:2 && pnpm test:3 && pnpm test:4 && pnpm test:5 && pnpm test:6 && pnpm test:7 && pnpm test:8 && pnpm test:9 && pnpm test:10 && pnpm test:11",
    "snapshot": "forge snapshot --no-match-path \"test/{fork/*,ExecuteStake50Flow.t.sol,options/*}\"",
    "clean": "forge clean",
    "lint": "solhint 'src/**/*.sol'"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "forge-std": "^1.1.2",
    "solhint": "^4.5.4"
  }
}
