{
  "name": "@unifyvault/protocol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:1": "forge test --match-path \"test/unit/*\"",
    "test:2": "forge test --match-path \"test/{AddressValidationLib,MathValidationLib,OracleValidationLib,ShareLibPrecision,GovernanceMigration,ProtocolDirectory,TimelockHardening,SecurityMonitoringEvents}.t.sol\"",
    "test:3": "forge test --match-path \"test/{Treasury,CustodyVault,AccountingModel,RateLimits}.t.sol\"",
    "test:4": "forge test --match-path \"test/{ChainlinkOracleProvider,OracleAdapter,OracleCircuitBreaker,OracleManager,OracleProvider}.t.sol\"",
    "test:5": "forge test --match-path \"test/{PortfolioManager,StrategyManager,LiquidityManager}.t.sol\"",
    "test:6": "forge test --match-path \"test/{UnifyVaultController,DepositCollateral,DepositMinting,DepositValidation,Redemption,UVBTCETHToken}.t.sol\"",
    "test:7": "forge test --match-path \"test/{DepositFeeRouting,FeeManager,SwapAdapter}.t.sol\"",
    "test:8": "forge test --match-path \"test/{integration/*.t.sol,ControllerIntegration.t.sol,FeeManagerIntegration.t.sol,LiveSim.t.sol,EconomicAdversarial.t.sol}\"",
    "test:9": "forge test --match-path \"test/{fork/*.t.sol,BaseMainnetFork.t.sol}\"",
    "test:10": "forge test --match-path \"test/{invariant/*.t.sol,*Invariant.t.sol,RedemptionFuzz.t.sol,V2ProtocolInvariants.t.sol}\"",
    "test:all": "pnpm test:1 && pnpm test:2 && pnpm test:3 && pnpm test:4 && pnpm test:5 && pnpm test:6 && pnpm test:7 && pnpm test:8 && pnpm test:9 && pnpm test:10",
    "clean": "forge clean",
    "lint": "solhint 'src/**/*.sol'"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "forge-std": "^1.1.2",
    "solhint": "^4.5.4"
  }
}
