    "test:4": "forge test --match-path \"test/{ChainlinkOracleProvider,OracleAdapter,OracleCircuitBreaker,OracleManager,OracleProvider}.t.sol\"",
    "test:5": "forge test --match-path \"test/{PortfolioManager,StrategyManager,LiquidityManager}.t.sol\"",
    "test:6": "forge test --match-path \"test/{UnifyVaultController,UnifyVaultControllerUpgradeable,DeployUnifyVaultControllerUUPS,DepositCollateral,DepositMinting,DepositValidation,DebugDepositQuote,Redemption,RedemptionDecimalScaling,UVBTCETHToken}.t.sol\"",
    "test:7": "forge test --match-path \"test/{DepositFeeRouting,FeeManager,SwapAdapter,SwapProtection}.t.sol\"",
