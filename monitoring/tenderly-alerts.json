{
  "project": "unifyvault-v2",
  "alerts": [
    {
      "id": "alert-oracle-stale",
      "name": "Oracle Stale Alert",
      "description": "Triggered when oracle returns stale price or triggers OracleFailure event",
      "event_type": "event_log",
      "severity": "high",
      "condition": {
        "event_name": "OracleFailure",
        "contract_name": "OracleManager"
      },
      "destinations": ["slack-sec-alerts", "pagerduty-critical"]
    },
    {
      "id": "alert-oracle-deviation",
      "name": "Oracle Deviation Circuit Breaker",
      "description": "Triggered when oracle fallback is activated or circuit breaker trips",
      "event_type": "event_log",
      "severity": "high",
      "condition": {
        "event_name": "OracleFallback",
        "contract_name": "OracleManager"
      },
      "destinations": ["slack-sec-alerts", "pagerduty-critical"]
    },
    {
      "id": "alert-large-deposit",
      "name": "Large Deposit Detected",
      "description": "Triggered when deposit exceeds threshold",
      "event_type": "event_log",
      "severity": "info",
      "condition": {
        "event_name": "LargeDeposit",
        "contract_name": "UnifyVaultController"
      },
      "destinations": ["slack-sec-alerts"]
    },
    {
      "id": "alert-large-withdrawal",
      "name": "Large Withdrawal Detected",
      "description": "Triggered when redemption exceeds threshold",
      "event_type": "event_log",
      "severity": "medium",
      "condition": {
        "event_name": "LargeRedeem",
        "contract_name": "UnifyVaultController"
      },
      "destinations": ["slack-sec-alerts"]
    },
    {
      "id": "alert-emergency-pause",
      "name": "Emergency Pause Triggered",
      "description": "Triggered when Guardian pauses protocol execution",
      "event_type": "event_log",
      "severity": "critical",
      "condition": {
        "event_name": "EmergencyPause",
        "contract_name": "UnifyVaultController"
      },
      "destinations": ["slack-sec-alerts", "pagerduty-critical", "sms-oncall"]
    },
    {
      "id": "alert-role-changes",
      "name": "AccessControl Role Change",
      "description": "Triggered when roles are granted or revoked on protocol contracts",
      "event_type": "event_log",
      "severity": "high",
      "condition": {
        "event_name": "RoleGranted",
        "contract_name": "UnifyVaultController"
      },
      "destinations": ["slack-sec-alerts"]
    },
    {
      "id": "alert-strategy-drift",
      "name": "Strategy Allocation Drift",
      "description": "Triggered when strategy weights are updated or rebalanced",
      "event_type": "event_log",
      "severity": "medium",
      "condition": {
        "event_name": "StrategyRebalanced",
        "contract_name": "StrategyManager"
      },
      "destinations": ["slack-sec-alerts"]
    },
    {
      "id": "alert-tvl-drop-10pct",
      "name": "TVL Drop Exceeds 10%",
      "description": "Triggered when protocol NAV drops by > 10% in an hour",
      "event_type": "metric_threshold",
      "severity": "critical",
      "condition": {
        "metric": "tvl_usd",
        "operator": "pct_change_less_than",
        "value": -10.0,
        "timeframe": "1h"
      },
      "destinations": ["slack-sec-alerts", "pagerduty-critical"]
    }
  ]
}
