# RPC Configuration
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Protocol Administrator Address (SafePal Hardware Wallet)
NEXT_PUBLIC_ADMIN_ADDRESS=0xd905920c91853039060246Ed5724AA72B91a96DA

# Etherscan / Basescan API Key for Contract Verification
BASESCAN_API_KEY=your_basescan_api_key_here

# WalletConnect Cloud Project ID & Relay URL
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=146781145b65a1c63ffcd7d6eaf03bd1
NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=wss://relay.walletconnect.org

# Account Abstraction (Self-Hosted / Provider-Agnostic Infrastructure)
# No third-party card or billing required
BUNDLER_RPC_URL=http://127.0.0.1:4337
PAYMASTER_RPC_URL=/api/smart-account/sponsor
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AA_SPONSORSHIP_ENABLED=true

# P2P Payment Data AES-256-GCM Encryption Key (Must be at least 16 chars / recommended 32-byte hex)
PAYMENT_DATA_ENCRYPTION_KEY=replace_with_secure_random_32_byte_hex_key

