# UnifyVault Web Production & Staging Environment Variables

# Web3 Provider Config
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Network Chain Selection: 'base-mainnet' (8453) or 'base-sepolia' (84532)
NEXT_PUBLIC_ACTIVE_CHAIN=base-mainnet

# Base Mainnet Config (Chain ID: 8453)
NEXT_PUBLIC_RPC_URL_BASE_MAINNET=https://mainnet.base.org
NEXT_PUBLIC_DIRECTORY_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000

# Base Sepolia Testnet Config (Chain ID: 84532)
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
NEXT_PUBLIC_DIRECTORY_ADDRESS_SEPOLIA=0xDd29e54f91b86f3e4609AA2e279e04E98dcAb722

# Block Explorer API
NEXT_PUBLIC_BASESCAN_API_KEY=your_basescan_api_key_here
